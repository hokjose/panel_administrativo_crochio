---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabase } from "../../lib/supabase";

const { data: categorias, error } = await supabase
  .from("categorias")
  .select("*");

console.log("CATEGORIAS:", categorias);

console.log("ERROR:", error);

const { data: productos } = await supabase.from("productos").select(`
    *,
    categorias(nombre)
  `);
// 👈 AQUÍ DEFINIMOS EL TOTAL DE PRODUCTOS CORRECTAMENTE
const totalProductos = productos?.length || 0;
---

<AdminLayout title="Productos">
  <!-- Cabecera y controles superiores -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
    {/* Fila 1: Título, Contador y Botón de Agregar */}
    <div
      class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6"
    >
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-bold text-gray-800">Gestión de Productos</h2>
        <!-- Insignia con la cantidad de productos registrados -->
        <span
          class="bg-rose-50 text-rose-700 text-xs font-semibold px-3 py-1 rounded-full border border-rose-100"
        >
          {totalProductos}
          {totalProductos === 1 ? "producto" : "productos"}
        </span>
      </div>

      <button
        id="btnAbrirModal"
        class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2.5 rounded-xl font-medium shadow-md shadow-rose-200 transition flex items-center gap-2 text-sm"
      >
        <svg
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 4v16m8-8H4"></path>
        </svg>
        Agregar producto
      </button>
    </div>

    {/* Fila 2: Lupa de buscador y Selector deslizable de categorías */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {/* 1. Lupa de Buscador */}
      <div class="relative">
        <div
          class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400"
        >
          <svg
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 21-4.35-4.35"></path>
          </svg>
        </div>
        <input
          type="text"
          id="inputBuscador"
          placeholder="Buscar por nombre o código..."
          class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2.5 pl-10 pr-4 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition"
        />
      </div>

      {/* 2. Ventana deslizable (Select) de Categorías con opción "Todos" */}
      <div>
        <select
          id="selectFiltroCategoria"
          class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2.5 px-4 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition cursor-pointer"
        >
          <option value="todos">📁 Todas las categorías (Todos)</option>
          {
            categorias?.map((cat) => (
              <option value={cat.id}>{cat.nombre}</option>
            ))
          }
        </select>
      </div>
    </div>
    <div
      id="mensajeSinResultados"
      class="hidden text-center py-8 text-gray-500 text-sm font-medium"
    >
      Lo sentimos CROCHIO 🥹🥹aun no tenemos ese producto en nuestro catalogo
    </div>
  </div>

  <div
    id="modalProducto"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4"
  >
    <div
      class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-150"
    >
      <div
        class="flex justify-between items-center px-6 py-4 border-b border-gray-100 bg-gray-50"
      >
        <div class="mb-4">
          <h3 class="font-bold text-lg text-blue-800">Nuevo Producto</h3>
          <h4 class="text-xs text-gray-500 mt-0.5">
            A continuación en esta sección ingresa los campos del nuevo producto
          </h4>
        </div>
        <button
          id="btnCerrarModal"
          class="text-gray-400 hover:text-gray-600 p-1 rounded-lg transition"
        >
          <svg
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="p-6 max-h-[80vh] overflow-y-auto">
        <form id="formProducto" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"
              >Nombre</label
            >
            <input
              name="nombre"
              placeholder="Ej: Chaleco tejido a mano"
              class="border border-gray-200 bg-gray-50 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"
              >Descripción</label
            >
            <textarea
              name="descripcion"
              placeholder="Detalles del producto..."
              rows="3"
              class="border border-gray-200 bg-gray-50 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition"
            ></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1"
                >Precio ($)</label
              >
              <input
                type="number"
                step="0.01"
                name="precio"
                placeholder="0.00"
                class="border border-gray-200 bg-gray-50 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition"
                required
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1"
                >Stock</label
              >
              <input
                type="number"
                name="stock"
                placeholder="0"
                class="border border-gray-200 bg-gray-50 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition"
                required
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"
              >Categoría</label
            >
            <select
              name="categoria_id"
              class="border border-gray-200 bg-gray-50 p-3 rounded-xl w-full text-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:bg-white transition"
              required
            >
              <option value="">Seleccione categoría</option>
              {
                categorias?.map((cat) => (
                  <option value={cat.id}>{cat.nombre}</option>
                ))
              }
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"
              >Imagen del producto</label
            >
            <input
              type="file"
              id="imagen"
              name="imagen"
              accept="image/png,image/jpeg,image/jpg,image/webp"
              class="border border-gray-200 bg-gray-50 p-2 rounded-xl w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-rose-50 file:text-rose-700 hover:file:bg-rose-100 transition"
            />
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Estado del Producto</label
            >
            <select
              name="estado"
              class="w-full border border-gray-300 rounded-xl p-2.5 text-sm focus:ring-2 focus:ring-rose-500 focus:outline-none"
            >
              <option value="true">Activo (Visible en la tienda)</option>
              <option value="false">Borrador (Oculto)</option>
            </select>
          </div>

          <div
            class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100"
          >
            <!-- Botones de Acción -->
            <div
              class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100"
            >
              <button
                type="button"
                id="btnCancelar"
                class="px-4 py-2.5 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-100 transition"
              >
                Cancelar
              </button>

              <div class="flex items-center gap-3">
                <button
                  id="btnGuardar"
                  type="submit"
                  class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2.5 rounded-xl text-sm font-medium shadow-md shadow-rose-200 transition"
                >
                  Guardar producto
                </button>

                <!-- Spinner de carga (oculto por defecto con 'hidden') -->
                <div id="spinnerGuardar" class="hidden flex items-center gap-2">
                  <div
                    class="w-5 h-5 border-2 border-rose-300 border-t-rose-600 rounded-full animate-spin"
                  >
                  </div>
                  <span class="text-xs text-gray-500 font-medium"
                    >Procesando...</span
                  >
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <p id="mensaje" class="mt-3"></p>

  <div id="modalEditar" class="hidden mt-6 border p-4 rounded">
    <h2 class="text-xl font-bold mb-4">Editar producto</h2>

    <input id="editId" type="hidden" />

    <input
      id="editNombre"
      class="border p-2 rounded w-full mb-2"
      placeholder="Nombre"
    />

    <textarea
      id="editDescripcion"
      class="border p-2 rounded w-full mb-2"
      placeholder="DescripciÃ³n"
    >
    </textarea>

    <input
      id="editPrecio"
      type="number"
      class="border p-2 rounded w-full mb-2"
      placeholder="Precio"
    />

    <input
      id="editStock"
      type="number"
      class="border p-2 rounded w-full mb-2"
      placeholder="Stock"
    />

    <input
      type="file"
      id="imagen"
      name="imagen"
      accept="image/png,image/jpeg,image/jpg,image/webp"
      class="border p-2 rounded w-full"
    />

    <button
      id="btnActualizar"
      class="bg-green-600 text-white px-4 py-2 rounded"
    >
      Actualizar
    </button>
  </div>

  <script type="module">
    import { supabase } from "../../lib/supabase";
    let productoEditando = null;
    const form = document.getElementById("formProducto");
    const modal = document.getElementById("modalProducto");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const mensaje = document.getElementById("mensaje");
      if (mensaje) {
        mensaje.className = "text-center mt-4 text-sm text-red-600";
      }

      // VALIDACIÓN DE CAMPOS VACÍOS (tus validaciones previas...)
      const nombreVal = form.querySelector("[name='nombre']").value.trim();
      const precioVal = form.querySelector("[name='precio']").value;
      const stockVal = form.querySelector("[name='stock']").value;
      const categoriaVal = form.querySelector("[name='categoria_id']").value;

      if (!nombreVal) {
        if (mensaje)
          mensaje.textContent = "¡Te falta ingresar el campo: Nombre!";
        form.querySelector("[name='nombre']").focus();
        return;
      }
      if (!precioVal) {
        if (mensaje)
          mensaje.textContent = "¡Te falta ingresar el campo: Precio!";
        form.querySelector("[name='precio']").focus();
        return;
      }
      if (!stockVal) {
        if (mensaje)
          mensaje.textContent = "¡Te falta ingresar el campo: Stock!";
        form.querySelector("[name='stock']").focus();
        return;
      }
      if (!categoriaVal) {
        if (mensaje)
          mensaje.textContent = "¡Te falta seleccionar una Categoría!";
        form.querySelector("[name='categoria_id']").focus();
        return;
      }

      if (mensaje) mensaje.textContent = "";

      // 👉 ACTIVAR SPINNER Y BLOQUEAR BOTÓN AQUÍ
      const spinnerGuardar = document.getElementById("spinnerGuardar");
      const btnGuardar = document.getElementById("btnGuardar");
      spinnerGuardar?.classList.remove("hidden");
      spinnerGuardar?.classList.add("flex");
      if (btnGuardar) btnGuardar.disabled = true;

      const datos = new FormData(form);

      // Obtener la imagen seleccionada
      const archivo = datos.get("imagen");
      let urlImagen = "";

      // Si se seleccionó una nueva imagen, la subimos
      if (archivo && archivo.size > 0) {
        const nombreArchivo = Date.now() + "_" + archivo.name;

        const { data, error } = await supabase.storage
          .from("productos")
          .upload(nombreArchivo, archivo);

        if (error) {
          alert(error.message);
          // Ocultar spinner si hay error
          spinnerGuardar?.classList.add("hidden");
          if (btnGuardar) btnGuardar.disabled = false;
          return;
        }

        urlImagen = supabase.storage
          .from("productos")
          .getPublicUrl(nombreArchivo).data.publicUrl;
      }
      // Capturamos el valor del select de estado y lo convertimos a booleano real
      const selectEstado = form.querySelector("[name='estado']");
      const valorEstado = selectEstado ? selectEstado.value === "true" : true;
      const producto = {
        nombre: datos.get("nombre"),
        descripcion: datos.get("descripcion"),
        precio: Number(datos.get("precio")),
        stock: Number(datos.get("stock")),
        categoria_id: datos.get("categoria_id"),
        estado: valorEstado, // 👈 Esto envía true o false de forma limpia
      };

      let metodo = "POST";
      let url = "/api/productos";

      if (productoEditando) {
        metodo = "PUT";
        producto.id = productoEditando;
        if (urlImagen) {
          producto.imagen = urlImagen;
        }
      } else {
        producto.imagen = urlImagen;
      }

      const respuesta = await fetch(url, {
        method: metodo,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(producto),
      });

      const resultado = await respuesta.json();

      if (mensaje) mensaje.textContent = resultado.message;

      if (resultado.success) {
        form.reset();
        productoEditando = null;
        if (btnGuardar) btnGuardar.textContent = "Guardar producto";

        // Cerrar modal
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");

        setTimeout(() => {
          location.reload();
        }, 1000);
      } else {
        // Si falla en el servidor, ocultamos el spinner y reactivamos el botón
        spinnerGuardar?.classList.add("hidden");
        if (btnGuardar) btnGuardar.disabled = false;
      }
    });

    // BOTON ELIMINAR PRODUCTO
    document.querySelectorAll(".btnEliminar").forEach((boton) => {
      boton.addEventListener("click", async () => {
        const id = boton.dataset.id;
        const confirmar = confirm("¿Desea eliminar este producto?");

        if (!confirmar) return;

        const respuesta = await fetch("/api/productos", {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ id: id }),
        });

        const resultado = await respuesta.json();
        alert(resultado.message);

        if (resultado.success) {
          location.reload();
        }
      });
    });

    // EDITAR PRODUCTO
    document.querySelectorAll(".btnEditar").forEach((boton) => {
      boton.addEventListener("click", async () => {
        const id = boton.dataset.id;

        const respuesta = await fetch(`/api/productos?id=${id}`);
        const producto = await respuesta.json();

        productoEditando = producto.id;

        // Llenar formulario
        document.querySelector("[name='nombre']").value = producto.nombre;
        document.querySelector("[name='descripcion']").value =
          producto.descripcion ?? "";
        document.querySelector("[name='precio']").value = producto.precio;
        document.querySelector("[name='stock']").value = producto.stock;
        document.querySelector("[name='categoria_id']").value =
          producto.categoria_id;

        // Nota: No intentamos asignar valor al input file por seguridad del navegador,
        // la imagen actual se puede manejar en el backend si no se sube una nueva.

        // Cambiar texto del botón
        document.getElementById("btnGuardar").textContent = "Actualizar";

        // ABRIR EL MODAL AUTOMÁTICAMENTE PARA QUE SE VEA EL FORMULARIO LLENO
        modal?.classList.remove("hidden");
        modal?.classList.add("flex");
      });
    });

    // CONTROL DEL MODAL (Abrir / Cerrar)
    const btnAbrir = document.getElementById("btnAbrirModal");
    const btnCerrar = document.getElementById("btnCerrarModal");
    const btnCancelar = document.getElementById("btnCancelar");

    btnAbrir?.addEventListener("click", () => {
      form.reset(); // Limpiar si era edición previa
      productoEditando = null;
      document.getElementById("btnGuardar").textContent = "Guardar producto";
      modal?.classList.remove("hidden");
      modal?.classList.add("flex");
    });

    const cerrarModal = () => {
      modal?.classList.add("hidden");
      modal?.classList.remove("flex");
    };

    btnCerrar?.addEventListener("click", cerrarModal);
    btnCancelar?.addEventListener("click", cerrarModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        cerrarModal();
      }
    });

    const inputBuscador = document.getElementById("inputBuscador");
    const selectFiltro = document.getElementById("selectFiltroCategoria");
    const mensajeSinResultados = document.getElementById(
      "mensajeSinResultados",
    );

    const filtrarTabla = () => {
      const textoBusqueda = inputBuscador?.value.toLowerCase() || "";
      const categoriaSeleccionada = selectFiltro?.value || "todos";

      const filas = document.querySelectorAll("tbody tr");
      let encontrados = 0;

      filas.forEach((fila) => {
        const textoFila = fila.textContent?.toLowerCase() || "";
        const coincideTexto = textoFila.includes(textoBusqueda);

        // Si tienes el id de la categoría en la fila (opcional), puedes afinarlo aquí,
        // por ahora filtra por el texto general de la fila:
        if (coincideTexto) {
          fila.style.display = "";
          encontrados++;
        } else {
          fila.style.display = "none";
        }
      });

      // Mostrar u ocultar el mensaje si no hay coincidencias
      if (encontrados === 0) {
        mensajeSinResultados?.classList.remove("hidden");
      } else {
        mensajeSinResultados?.classList.add("hidden");
      }
    };

    inputBuscador?.addEventListener("input", filtrarTabla);
    selectFiltro?.addEventListener("change", filtrarTabla);
  </script>

  <div
    class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mt-8"
  >
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr
            class="bg-gray-50/75 border-b border-gray-100 text-gray-500 text-xs uppercase tracking-wider font-semibold"
          >
            <th class="py-4 px-6">Imagen</th>
            <th class="py-4 px-6">Código</th>
            <th class="py-4 px-6">Nombre</th>
            <th class="py-4 px-6">Categoría</th>
            <th class="py-4 px-6">Precio</th>
            <th class="py-4 px-6">Stock</th>
            <th class="py-4 px-6 text-center">Estado</th>
            <th class="py-4 px-6 text-center">Acciones</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
          {
            productos?.map((prod) => (
              <tr class="hover:bg-rose-50/30 transition-colors">
                <td class="py-4 px-6">
                  {prod.imagen ? (
                    <img
                      src={prod.imagen}
                      alt={prod.nombre}
                      class="w-12 h-12 object-cover rounded-xl shadow-sm border border-gray-100"
                    />
                  ) : (
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-500">
                      Sin imagen
                    </span>
                  )}
                </td>

                <td class="py-4 px-6 font-mono text-xs text-gray-500">
                  {prod.codigo}
                </td>

                <td class="py-4 px-6 font-semibold text-gray-800">
                  {prod.nombre}
                </td>

                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-rose-50 text-rose-700">
                    {prod.categorias?.nombre || "Sin categoría"}
                  </span>
                </td>

                <td class="py-4 px-6 font-medium text-gray-900">
                  S/. {prod.precio}
                </td>

                <td class="py-4 px-6">
                  <span
                    class={`font-medium ${prod.stock <= 5 ? "text-amber-600 bg-amber-50 px-2 py-1 rounded-md text-xs" : "text-gray-700"}`}
                  >
                    {prod.stock}
                  </span>
                </td>

                <td class="py-4 px-6 text-center">
                  <span
                    class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium ${prod.estado !== false ? "bg-emerald-50 text-emerald-700" : "bg-gray-100 text-gray-600"}`}
                  >
                    {prod.estado !== false ? "Activo" : "Borrador"}
                  </span>
                </td>

                <td class="py-4 px-6">
                  <div class="flex items-center justify-center gap-2">
                    <button
                      data-id={prod.id}
                      class="bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded-xl text-xs font-medium shadow-sm transition btnEditar flex items-center gap-1"
                    >
                      Editar
                    </button>

                    <button
                      data-id={prod.id}
                      class="bg-rose-600 hover:bg-rose-700 text-white px-3 py-1.5 rounded-xl text-xs font-medium shadow-sm transition btnEliminar flex items-center gap-1"
                    >
                      Eliminar
                    </button>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
